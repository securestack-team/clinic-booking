{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "rules": [
            {
              "id": "aws-access-token",
              "shortDescription": { "text": "Identified a pattern that may indicate AWS credentials." }
            }
          ]
        }
      },
      "results": [
        {
          "message": { "text": "aws-access-token has detected secret for file api/appsettings.json." },
          "ruleId": "aws-access-token",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "api/appsettings.json" },
                "region": { "startLine": 3, "startColumn": 20, "endLine": 3, "endColumn": 39, "snippet": { "text": "REDACTED" } }
              }
            }
          ],
          "partialFingerprints": { "commitSha": "1111111", "email": "dev@example.com", "author": "dev", "date": "2026-10-12T10:00:00Z", "commitMessage": "feat: config" },
          "properties": { "tags": [] }
        },
        {
          "message": { "text": "aws-access-token has detected secret for file api/appsettings.json." },
          "ruleId": "aws-access-token",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "api/appsettings.json" },
                "region": { "startLine": 3, "startColumn": 20, "endLine": 3, "endColumn": 39, "snippet": { "text": "REDACTED" } }
              }
            }
          ],
          "partialFingerprints": { "commitSha": "2222222", "email": "dev@example.com", "author": "dev", "date": "2026-10-12T11:00:00Z", "commitMessage": "fix: typo" },
          "properties": { "tags": [] }
        }
      ]
    }
  ]
}
