# Copier en .env (jamais commité) et remplacer les valeurs.
POSTGRES_DB=clinicbooking
POSTGRES_USER=clinicbooking
POSTGRES_PASSWORD=change-me
ASPNETCORE_ENVIRONMENT=Development
# Clé de signature des tokens JWT : 32 caractères minimum (ex. : openssl rand -base64 48)
JWT_KEY=change-me-with-a-long-random-value-of-32-chars-min
JWT_ISSUER=ClinicBooking
JWT_AUDIENCE=ClinicBooking
